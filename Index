    def set_controls(self, playing: bool) -> None:
        self.btn_hit.config(state=("normal" if playing else "disabled"))
        self.btn_stand.config(state=("normal" if playing else "disabled"))
        bet_state = "disabled" if playing else "normal"
        for btn in self.bet_buttons:
            btn.config(state=bet_state)

    def adjust_bet(self, amount: int) -> None:
        if not self.round_over:
            return
        if self.bankroll <= 0:
            self.status_var.set("Je saldo is op. Start opnieuw om te resetten.")
            return
        if self.bet + amount > self.bankroll:
            self.status_var.set("Onvoldoende saldo voor deze inzet.")
            return
        self.bet += amount
        self.bet_var.set(f"Inzet: €{self.bet}")
        self.status_var.set("Klaar voor de deal. Druk op New Game.")

    def clear_bet(self) -> None:
        if not self.round_over:
            return
        self.bet = 0
        self.bet_var.set("Inzet: €0")
        self.status_var.set("Plaats een inzet om te beginnen.")

    def new_game(self) -> None:
        if self.bet <= 0:
            self.status_var.set("Plaats eerst een inzet.")
            messagebox.showinfo("Inzet nodig", "Plaats eerst een inzet om te spelen.")
            return
        if self.bet > self.bankroll:
            self.status_var.set("Onvoldoende saldo voor deze inzet.")
            return
        if len(self.deck.cards) < 18:
            self.deck.reset()

        self.player = Hand()
        self.dealer = Hand()
        self.round_over = False
        self.hide_dealer_first = True
        self.bankroll -= self.bet
        self.bankroll_var.set(f"Saldo: €{self.bankroll}")

        self.player.add(self.deck.deal())
        self.dealer.add(self.deck.deal())
        self.player.add(self.deck.deal())
        self.dealer.add(self.deck.deal())

        self.status_var.set("Jouw beurt: Hit of Stand?")
        self.set_controls(True)
        self.render()

        if self.player.blackjack() or self.dealer.blackjack():
            self.finish_round(immediate=True)

    def hit(self) -> None:
        if self.round_over:
            return
        self.player.add(self.deck.deal())
        self.render()
        if self.player.bust():
            self.finish_round()

    def stand(self) -> None:
        if self.round_over:
            return
        self.finish_round()

    def dealer_play(self) -> None:
        while self.dealer.value() < 17:
            self.dealer.add(self.deck.deal())

    def finish_round(self, immediate: bool = False) -> None:
        self.round_over = True
        self.hide_dealer_first = False
        self.set_controls(False)

        if not self.player.bust() and not immediate:
            self.dealer_play()

        self.render()

        p = self.player.value()
        d = self.dealer.value()

        if self.player.blackjack() and self.dealer.blackjack():
            msg = "Push. Beide Blackjack!"
            self.pushes += 1
            self.bankroll += self.bet
        elif self.player.blackjack():
            msg = "Blackjack! Jij wint 🎉"
            self.wins += 1
            self.bankroll += int(self.bet * 2.5)
        elif self.dealer.blackjack():
            msg = "Dealer heeft Blackjack. Jij verliest."
            self.losses += 1
        elif self.player.bust():
            msg = "Bust! Over 21. Jij verliest."
            self.losses += 1
        elif self.dealer.bust():
            msg = "Dealer bust! Jij wint 🎉"
            self.wins += 1
            self.bankroll += self.bet * 2
        else:
            if p > d:
                msg = "Jij wint 🎉"
                self.wins += 1
                self.bankroll += self.bet * 2
            elif p < d:
                msg = "Dealer wint."
                self.losses += 1
            else:
                msg = "Push (gelijkspel)."
                self.pushes += 1
                self.bankroll += self.bet

        self.bet = 0
        self.bankroll_var.set(f"Saldo: €{self.bankroll}")
        self.bet_var.set("Inzet: €0")
        self.stats_var.set(f"W: {self.wins} • V: {self.losses} • Push: {self.pushes}")
        self.status_var.set(msg)
        messagebox.showinfo("Ronde afgelopen", msg)

    def render(self) -> None:
        self.canvas.delete("cards")
        self.canvas.delete("overlay")

        w = self.canvas.winfo_width()
        h = self.canvas.winfo_height()
        if w <= 2 or h <= 2:
            return

        # Royal title plaque
        self.canvas.create_text(
            w / 2 + 2, 44, text="BLACKJACK ROYALE",
            fill=THEME["mahogany_hi"], font=("Helvetica", 28, "bold"),
            tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, 42, text="BLACKJACK ROYALE",
            fill=THEME["gold"], font=("Helvetica", 28, "bold"),
            tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, 78, text=self.status_var.get(),
            fill=THEME["muted"], font=("Helvetica", 14),
            tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, 108, text=f"{self.bankroll_var.get()}    {self.bet_var.get()}    {self.stats_var.get()}",
            fill=THEME["muted"], font=("Helvetica", 13, "bold"),
            tags=("overlay",)
        )

        dealer_val = "?" if (self.hide_dealer_first and not self.round_over) else str(self.dealer.value()) if self.dealer.cards else "-"
        player_val = str(self.player.value()) if self.player.cards else "-"

        self.canvas.create_text(
            w / 2, int(h * 0.20), text=f"Dealer • waarde: {dealer_val}",
            fill=THEME["text"], font=("Helvetica", 16, "bold"),
            tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, int(h * 0.62), text=f"Jij • waarde: {player_val}",
            fill=THEME["text"], font=("Helvetica", 16, "bold"),
            tags=("overlay",)
        )

        def layout_for(count: int) -> Tuple[int, int, int]:
            gap = 18
            base_w = 120
            max_width = int(w * 0.75)
            if count > 0:
                needed = count * base_w + (count - 1) * gap
                if needed > max_width:
                    base_w = max(80, int((max_width - (count - 1) * gap) / count))
            return base_w, int(base_w * 1.45), gap

        # Dealer
        dealer_cards = self.dealer.cards[:]
        card_w, card_h, gap = layout_for(len(dealer_cards))
        dealer_y = int(h * 0.24)
        dealer_total = len(dealer_cards) * card_w + max(0, len(dealer_cards) - 1) * gap
        dealer_x0 = int((w - dealer_total) / 2)

        for i, c in enumerate(dealer_cards):
            x = dealer_x0 + i * (card_w + gap)
            face_down = (i == 0 and self.hide_dealer_first and not self.round_over)
            self.canvas.draw_card(x, dealer_y, card_w, card_h, c, face_down=face_down, tag="cards")

        # Player
        player_cards = self.player.cards[:]
        card_w, card_h, gap = layout_for(len(player_cards))
        player_y = int(h * 0.70) - card_h
        player_total = len(player_cards) * card_w + max(0, len(player_cards) - 1) * gap
        player_x0 = int((w - player_total) / 2)

        for i, c in enumerate(player_cards):
            x = player_x0 + i * (card_w + gap)
            self.canvas.draw_card(x, player_y, card_w, card_h, c, face_down=False, tag="cards")

        # Value badges
        badge_w = 170
        badge_h = 32
        self.canvas.draw_rounded_rect(
            w / 2 - badge_w / 2, dealer_y - 44, w / 2 + badge_w / 2, dealer_y - 44 + badge_h,
            r=14, fill=THEME["mahogany_hi"], outline=THEME["gold_dark"], width=2, tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, dealer_y - 28, text=f"Dealer waarde: {dealer_val}",
            fill=THEME["text"], font=("Helvetica", 12, "bold"), tags=("overlay",)
        )
        self.canvas.draw_rounded_rect(
            w / 2 - badge_w / 2, player_y + card_h + 12, w / 2 + badge_w / 2, player_y + card_h + 12 + badge_h,
            r=14, fill=THEME["mahogany_hi"], outline=THEME["gold_dark"], width=2, tags=("overlay",)
        )
        self.canvas.create_text(
            w / 2, player_y + card_h + 28, text=f"Jij waarde: {player_val}",
            fill=THEME["text"], font=("Helvetica", 12, "bold"), tags=("overlay",)
        )

        # Bet stack visual
        if self.bet > 0:
            stack_x = int(w * 0.16)
            stack_y = int(h * 0.58)
            for i in range(3):
                offset = i * 6
                self.canvas.create_oval(stack_x, stack_y - offset, stack_x + 50, stack_y + 50 - offset,
                                        fill=THEME["mahogany_hi"], outline=THEME["gold"], width=2,
                                        tags=("overlay",))
                self.canvas.create_oval(stack_x + 10, stack_y + 10 - offset, stack_x + 40, stack_y + 40 - offset,
                                        fill=THEME["bg_bottom"], outline=THEME["gold_dark"], width=2,
                                        tags=("overlay",))
            self.canvas.create_text(stack_x + 25, stack_y + 70, text=f"Inzet €{self.bet}",
                                    fill=THEME["text"], font=("Helvetica", 12, "bold"),
                                    tags=("overlay",))

        # >>> FIX: ensure overlay always on top
        self.canvas.tag_raise("overlay")


