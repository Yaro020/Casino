def clamp(v: int) -> int:
    return max(0, min(255, v))

def hex_to_rgb(h: str) -> Tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

def rgb_to_hex(rgb: Tuple[int, int, int]) -> str:
    r, g, b = rgb
    return f"#{clamp(r):02x}{clamp(g):02x}{clamp(b):02x}"

def lerp(a: int, b: int, t: float) -> int:
    return int(a + (b - a) * t)

def lerp_color(c1: str, c2: str, t: float) -> str:
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex((lerp(r1, r2, t), lerp(g1, g2, t), lerp(b1, b2, t)))


class RoyalTableCanvas(tk.Canvas):
    def __init__(self, master, **kwargs):
        super().__init__(master, highlightthickness=0, **kwargs)
        self.bind("<Configure>", lambda e: self.redraw_background())

    def redraw_background(self) -> None:
        self.delete("bg")
        w = self.winfo_width()
        h = self.winfo_height()
        if w <= 2 or h <= 2:
            return

        # Background gradient
        steps = 70
        for i in range(steps):
            y0 = int(h * i / steps)
            y1 = int(h * (i + 1) / steps)
            col = lerp_color(THEME["bg_top"], THEME["bg_bottom"], i / (steps - 1))
            self.create_rectangle(0, y0, w, y1, fill=col, outline="", tags=("bg",))

        # Soft spotlight (IMPORTANT: always keep it behind)
        self.create_oval(-w * 0.15, -h * 0.35, w * 1.15, h * 0.9,
                         fill="#0d2a1c", outline="", tags=("bg",))
        self.create_oval(-w * 0.05, -h * 0.25, w * 1.05, h * 0.75,
                         fill="#103020", outline="", tags=("bg",))

        # Table
        pad = 26
        rim = 12
        x0, y0 = pad, int(h * 0.16)
        x1, y1 = w - pad, h - pad

        # shadow
        self.create_oval(x0 + 10, y0 + 18, x1 + 10, y1 + 18,
                         fill=THEME["felt_shadow"], outline="", tags=("bg",))

        # rim (mahogany + gold)
        self.create_oval(x0, y0, x1, y1,
                         fill=THEME["mahogany"], outline=THEME["gold_dark"],
                         width=3, tags=("bg",))
        self.create_oval(x0 + rim, y0 + rim, x1 - rim, y1 - rim,
                         fill=THEME["felt"], outline=THEME["gold"],
                         width=3, tags=("bg",))
        self.create_oval(x0 + 4, y0 + 4, x1 - 4, y1 - 4,
                         outline=THEME["mahogany_hi"], width=2, tags=("bg",))

        # felt pattern (subtle)
        inner_x0, inner_y0 = x0 + rim + 10, y0 + rim + 10
        inner_x1, inner_y1 = x1 - rim - 10, y1 - rim - 10
        for yy in range(int(inner_y0), int(inner_y1), 22):
            for xx in range(int(inner_x0), int(inner_x1), 22):
                self.create_oval(xx, yy, xx + 2, yy + 2, fill=THEME["felt2"], outline="", tags=("bg",))

        # Decorative chips around the table
        chip_positions = [
            (inner_x0 + 40, inner_y0 + 40),
            (inner_x1 - 70, inner_y0 + 60),
            (inner_x0 + 60, inner_y1 - 70),
            (inner_x1 - 90, inner_y1 - 80),
        ]
        for cx, cy in chip_positions:
            self.create_oval(cx, cy, cx + 46, cy + 46, fill=THEME["mahogany_hi"],
                             outline=THEME["gold"], width=2, tags=("bg",))
            self.create_oval(cx + 8, cy + 8, cx + 38, cy + 38, fill=THEME["bg_bottom"],
                             outline=THEME["gold_dark"], width=2, tags=("bg",))

        # >>> FIX: always send bg to the very back
        self.tag_lower("bg")

    def draw_rounded_rect(self, x0, y0, x1, y1, r=16, **kwargs):
        points = [
            x0 + r, y0,
            x1 - r, y0,
            x1, y0,
            x1, y0 + r,
            x1, y1 - r,
            x1, y1,
            x1 - r, y1,
            x0 + r, y1,
            x0, y1,
            x0, y1 - r,
            x0, y0 + r,
            x0, y0,
        ]
        return self.create_polygon(points, smooth=True, **kwargs)

    def draw_card(self, x, y, w, h, card: Optional[Card], face_down: bool = False, tag="cards"):
        # drop shadow
        shadow = 7
        self.draw_rounded_rect(x + shadow, y + shadow, x + w + shadow, y + h + shadow,
                               r=18, fill="#000000", outline="", stipple="gray50", tags=(tag,))

        # outer card
        self.draw_rounded_rect(x, y, x + w, y + h, r=18,
                               fill=THEME["card"], outline=THEME["card_edge"], width=2, tags=(tag,))

        if face_down or card is None:
            inset = 10
            self.draw_rounded_rect(x + inset, y + inset, x + w - inset, y + h - inset,
                                   r=14, fill=THEME["card_back"], outline=THEME["card_back_gold"],
                                   width=2, tags=(tag,))

            # back stripes
            for i in range(7):
                t = i / 6
                col = lerp_color(THEME["card_back"], THEME["card_back2"], t)
                yy0 = y + inset + int((h - 2 * inset) * i / 7)
                yy1 = y + inset + int((h - 2 * inset) * (i + 1) / 7)
                self.create_rectangle(x + inset + 2, yy0, x + w - inset - 2, yy1,
                                      fill=col, outline="", tags=(tag,))

            cx, cy = x + w / 2, y + h / 2
            self.create_text(cx, cy - 10, text="♛", fill=THEME["card_back_gold"],
                             font=("Helvetica", int(h * 0.28), "bold"), tags=(tag,))
            self.create_text(cx, cy + 38, text="ROYAL", fill=THEME["card_back_gold"],
                             font=("Helvetica", 14, "bold"), tags=(tag,))
            return

        rank, suit = card
        col = THEME["red"] if is_red_suit(suit) else THEME["black"]

        # corner
        self.create_text(x + 18, y + 14, text=rank, anchor="nw",
                         fill=col, font=("Helvetica", 18, "bold"), tags=(tag,))
        self.create_text(x + 18, y + 38, text=suit, anchor="nw",
                         fill=col, font=("Helvetica", 18, "bold"), tags=(tag,))

        self.create_text(x + w - 18, y + h - 14, text=rank, anchor="se",
                         fill=col, font=("Helvetica", 18, "bold"), tags=(tag,))
        self.create_text(x + w - 18, y + h - 38, text=suit, anchor="se",
                         fill=col, font=("Helvetica", 18, "bold"), tags=(tag,))

        # center
        center_size = int(h * 0.46)
        self.create_text(x + w / 2, y + h / 2 + 4, text=suit,
                         fill=col, font=("Helvetica", center_size, "bold"), tags=(tag,))


